# ---------------------------------------------------------------------------
# Tocsin — local development environment
#
# In production (Docker / Coolify) no .env file is needed: the container
# generates its application key on first boot and everything else is
# configured from the web interface (Administration → Settings).
# ---------------------------------------------------------------------------

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite by default. PostgreSQL / MySQL are supported too (DB_CONNECTION=pgsql, DB_HOST, ...).
DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# During development Reverb listens directly on port 8080
# (php artisan reverb:start). In Docker it is proxied on /app.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
TOCSIN_WS_PORT=8080
